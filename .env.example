# Copy to .env.local. Configure in Netlify for Builds AND Functions, then redeploy.
# demo: fictional Cedar Hollow policies and example stories (default)
# live: sourced Washington, DC bag-fee snapshot; no keys required
APP_MODE=live

# Optional replacement for the bundled live dataset. Both are required together.
# HTTPS JSON matching src/lib/feed-schema.ts, not a government HTML page.
# Feed failure shows an error; it NEVER substitutes fictional records.
# POLICY_FEED_URL=https://your-provider.example/policies.json
# POLICY_FEED_JURISDICTION_ID=your-jurisdiction-id
