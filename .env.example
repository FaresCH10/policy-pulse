# ---------------------------------------------------------------------------
# PolicyPulse — optional environment variables
# ---------------------------------------------------------------------------
# The core demo experience runs with NO credentials and NO network access.
# Everything below is optional and only affects features that degrade
# gracefully when unset. Copy this file to `.env.local` to enable them.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Optional: live / official policy feed ---------------------------------
# When set, `src/lib/providers/http-policy-provider.ts` will fetch verified
# policy records from this endpoint instead of using the bundled seed data.
# The endpoint must return JSON matching the `PolicyProviderResponse` schema in
# `src/lib/types.ts`. Leave unset to run in demo mode.
# POLICY_FEED_URL=https://example.gov/api/policies.json

# --- Optional: server-side AI summarization --------------------------------
# Used ONLY by the server route `POST /api/ai-summary`. The key is never sent
# to the browser. If unset, the route reports `available: false` and the UI
# hides the feature entirely (no broken buttons).
# AI_SUMMARY_PROVIDER=openai
# AI_SUMMARY_API_KEY=sk-...
# AI_SUMMARY_MODEL=gpt-4o-mini
# AI_SUMMARY_BASE_URL=https://api.openai.com/v1

# --- Optional: build metadata shown in the footer ---------------------------
# NEXT_PUBLIC_DEMO_BUILD_LABEL=hackathon-build
